<?xml version="1.0" encoding="utf-8"?>
<!-- ═══════════════════════════════════════════════════════════════════════════════
     悬浮窗 HUD· TrackLab 浅色纸面卡（2026-10-12 焕新，原创外观）：
     旧 Matrix/v2 玻璃 HUD 外观已整体替换——不透明浅色实底 + 中性描边 + 顶部白口沿，
     四格芯片 + 赭色合规标记 + 双色状态点。不依赖跨窗模糊（出厂默认关闭，见控制器），
     在任何桌面/应用背景上都是同一套完整外观。
     ═══════════════════════════════════════════════════════════════════════════════
     结构（几何沿用 OverlayGeometry 模型，主行 48dp / 展开 120dp / 折叠 64dp）：
     折叠态（64dp）= 主行 48dp：抓手 + 状态点 + 核心指标（圈+距离）+ 合规标记 + 暂停/停止/折叠三键；
     展开态（120dp）= 主行 + 8dp gap + 指标行 48dp（圈 / 距离 / 配速 / 步频四芯片）。
     折叠动效 = 控制器对 matrix_overlay_grid_wrap 的高度做 0↔56dp 插值，
     故该 wrap 自带 8dp paddingTop（gap 与指标行同一件，收起时不留 8dp 空带）。
     ───────────────────────────────────────────────────────────────────────────────
     与旧版的一处已知差异（OverlayGeometry.kt 未在本轮改动范围内，如实记录）：
     状态点从指标行移入主行后，主行固定宽 = 旧 216dp + 状态点 16dp + 间隙 8dp = 240dp，
     OverlayGeometry.MAIN_ROW_FIXED_WIDTH_DP 仍按 216dp 计算（纯函数测试不受影响）。
     393dp 视口下指标格实得 = 361 − 240 = 121dp，前两格 ≈134dp @12sp 靠 10–12sp
     自动收缩消化（需 ≈10.8sp ≥ 下限 10sp），更窄视口回退到省略号截断。
     ───────────────────────────────────────────────────────────────────────────────
     钉死 ID（docs/CONTRACTS.md）：overlay_root / txt_overlay_metrics /
     btn_overlay_pause / btn_overlay_stop —— 一个不少，改名即断测试；其余 11 个
     matrix_overlay_* ID 同样全部保留（位置可调，ID 不动）。
     文案键全部复用已有（不新增 strings.xml 键）：matrix_overlay_cd /
     matrix_overlay_grid_cd / matrix_hud_test_marker / cd_overlay_pause(resume/stop) /
     action_pause(resume/stop) / matrix_overlay_fold(expand)。
     调色板（单色化 2026-10-12）：纸面 #F2F2F2 / 墨 #111111 / 运行 #111111 /
     暂停 #5A5A5A / 标记格黑底白字 / 芯片 #E4E4E4 / 键底 #E4E4E4，不引用旧
     matrix_/v2_ 颜色令牌；图标复用既有白色矢量件（ic_ui_*），靠 drawableTint 染深色。
     装饰性 View（抓手 / 状态点）一律 clickable=false + focusable=false +
     importantForAccessibility="no"：**绝不吞掉主行/窗口的触摸与焦点**（拖窗靠 overlay_root）。
     按钮命中区 ≥48dp；悬浮窗三键 paddingStart/End 归零（en「Resume」不断行）。
     ═══════════════════════════════════════════════════════════════════════════════ -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlay_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/tl_overlay_card"
    android:contentDescription="@string/matrix_overlay_cd"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- ── 主行（48dp）：抓手 · 状态点 · 指标格 · 合规标记格 · 三键 ──────────────── -->
    <LinearLayout
        android:id="@+id/matrix_overlay_hud_row"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- 拖拽抓手（装饰）：2×20dp 圆头条。不吞事件（拖动由 overlay_root 处理）。 -->
        <View
            android:id="@+id/matrix_overlay_grip"
            android:layout_width="2dp"
            android:layout_height="20dp"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="8dp"
            android:background="@drawable/tl_overlay_grip"
            android:clickable="false"
            android:focusable="false"
            android:importantForAccessibility="no" />

        <!-- 状态点（16×16dp 宿主、14dp 环 + 8dp 圆点在正中；运行/暂停两态换件）。
             折叠态的状态表达 = 本点 + 指标行颜色 + 暂停键呼吸光。装饰性，不吞事件。 -->
        <View
            android:id="@+id/matrix_overlay_led"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="8dp"
            android:background="@drawable/tl_overlay_status_play"
            android:clickable="false"
            android:focusable="false"
            android:importantForAccessibility="no" />

        <!-- 指标格（weight=1）：12sp 等宽 mono、单行，主行文本 = 前两格（圈 + 距离，
             控制器按格切分，见 FloatingOverlayController.setMetricsOnMainThread）。
             字号自动收缩 10–12sp：视口更窄时自动降档；ellipsize 仅为退化视口的最后兜底。
             合规后缀不在此承担（合规由右侧 matrix_overlay_test_marker 恒在的标记格承担）。 -->
        <TextView
            android:id="@+id/txt_overlay_metrics"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:autoSizeMaxTextSize="12sp"
            android:autoSizeMinTextSize="10sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:clickable="false"
            android:ellipsize="end"
            android:focusable="false"
            android:gravity="start|center_vertical"
            android:includeFontPadding="false"
            android:letterSpacing="0.01"
            android:minWidth="96dp"
            android:singleLine="true"
            android:textColor="#111111"
            android:textSize="12sp"
            android:textStyle="bold"
            android:typeface="monospace" />

        <!-- 合规标记格：静态文本、**永不裁剪**、不随状态或指标串变化。
             悬浮窗上唯一的完整合规载体。黑底 + 白字（单色化 2026-10-12）。 -->
        <TextView
            android:id="@+id/matrix_overlay_test_marker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/tl_overlay_badge"
            android:clickable="false"
            android:contentDescription="@string/matrix_hud_test_marker"
            android:focusable="false"
            android:gravity="center"
            android:importantForAccessibility="yes"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:minWidth="28dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="@string/matrix_hud_test_marker"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold" />

        <!-- 暂停/继续（钉死 ID）：48×48dp、浅色键底、24dp 图标 + 11sp 文字、paddingH=0。
             内容高算式 = 24 图标 + 2 drawablePadding + 14 文字行 + 2 + 2 = 44 ≤ 48 ✔。
             PAUSED 时图标/文字由控制器改（继续 + 琥珀 tint + 呼吸光）。图标为白色矢量件，
             靠 drawableTint 染墨色（控制器在运行时按状态重染）。 -->
        <Button
            android:id="@+id/btn_overlay_pause"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/tl_overlay_key"
            android:contentDescription="@string/cd_overlay_pause"
            android:drawablePadding="2dp"
            android:drawableTint="#111111"
            android:drawableTop="@drawable/ic_ui_pause"
            android:focusable="true"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:minHeight="48dp"
            android:minWidth="48dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="@string/action_pause"
            android:textAllCaps="false"
            android:textColor="#111111"
            android:textSize="11sp" />

        <!-- 停止（钉死 ID）：同上，文字 / 图标换停止件。 -->
        <Button
            android:id="@+id/btn_overlay_stop"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/tl_overlay_key"
            android:contentDescription="@string/cd_overlay_stop"
            android:drawablePadding="2dp"
            android:drawableTint="#111111"
            android:drawableTop="@drawable/ic_ui_stop"
            android:focusable="true"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:minHeight="48dp"
            android:minWidth="48dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="@string/action_stop"
            android:textAllCaps="false"
            android:textColor="#111111"
            android:textSize="11sp" />

        <!-- 折叠/展开：纯图标键（text 为空，文案只进 contentDescription）——
             展开中文案会被撑宽并挤爆主行，故一律走图标。
             控制器用 setCompoundDrawablesWithIntrinsicBounds 换件：展开中→ic_ui_fold（上折），
             已折叠→ic_ui_expand（下折），并重染墨色 tint。 -->
        <Button
            android:id="@+id/matrix_overlay_fold_btn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/tl_overlay_key"
            android:contentDescription="@string/matrix_overlay_fold"
            android:drawablePadding="0dp"
            android:drawableTint="#111111"
            android:drawableTop="@drawable/ic_ui_fold"
            android:focusable="true"
            android:gravity="center"
            android:includeFontPadding="false"
            android:minHeight="48dp"
            android:minWidth="48dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:text="" />

    </LinearLayout>

    <!-- ── 展开态指标行（折叠态被控制器压到 0dp + GONE；默认展开，状态只存内存）───
         高度 = 8dp gap（本 wrap 的 paddingTop）+ 48dp 指标行 = 56dp
         = OverlayGeometry.GRID_ROW_GAP_DP + GRID_ROW_HEIGHT_DP（折叠动效的插值目标）。 -->
    <LinearLayout
        android:id="@+id/matrix_overlay_grid_wrap"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:clipChildren="true"
        android:clipToPadding="true"
        android:contentDescription="@string/matrix_overlay_grid_cd"
        android:importantForAccessibility="yes"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:visibility="visible">

        <!-- 4 格横排：圈 / 距离 / 配速 / 步频（各 weight=1、minWidth=48dp、11sp 等宽，
             每格一块浅色芯片 tl_overlay_cell，文字居中）。格间 8dp。
             4 格的文字由主行 txt_overlay_metrics 统一播报（同源串），故格体自身
             importantForAccessibility="no"，避免读屏把同一串数字念两遍。 -->
        <LinearLayout
            android:id="@+id/matrix_overlay_grid_row"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- 圈：PLAYING → 黑 / PAUSED → 中灰（单色化 2026-10-12）。 -->
            <TextView
                android:id="@+id/matrix_overlay_grid_circle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/tl_overlay_cell"
                android:clickable="false"
                android:ellipsize="end"
                android:focusable="false"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:includeFontPadding="false"
                android:minWidth="48dp"
                android:singleLine="true"
                android:textColor="#111111"
                android:textSize="11sp"
                android:textStyle="bold"
                android:typeface="monospace" />

            <!-- 距离 -->
            <TextView
                android:id="@+id/matrix_overlay_grid_distance"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/tl_overlay_cell"
                android:clickable="false"
                android:ellipsize="end"
                android:focusable="false"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:includeFontPadding="false"
                android:minWidth="48dp"
                android:singleLine="true"
                android:textColor="#111111"
                android:textSize="11sp"
                android:typeface="monospace" />

            <!-- 配速 -->
            <TextView
                android:id="@+id/matrix_overlay_grid_pace"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/tl_overlay_cell"
                android:clickable="false"
                android:ellipsize="end"
                android:focusable="false"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:includeFontPadding="false"
                android:minWidth="48dp"
                android:singleLine="true"
                android:textColor="#111111"
                android:textSize="11sp"
                android:typeface="monospace" />

            <!-- 步频 -->
            <TextView
                android:id="@+id/matrix_overlay_grid_cadence"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/tl_overlay_cell"
                android:clickable="false"
                android:ellipsize="end"
                android:focusable="false"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:includeFontPadding="false"
                android:minWidth="48dp"
                android:singleLine="true"
                android:textColor="#111111"
                android:textSize="11sp"
                android:typeface="monospace" />

        </LinearLayout>
    </LinearLayout>

</LinearLayout>
