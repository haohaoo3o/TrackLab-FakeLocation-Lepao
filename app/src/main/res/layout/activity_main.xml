<?xml version="1.0" encoding="utf-8"?>
<!--
  TrackLab 主界面 TL 焕新（原创外观；事实文案与业务接线不变）。
  层级 L0–L4：
    L0 系统带（常驻 48dp）：应用名 + 运行 LED + 状态词 + 时钟 + 测试徽标
    L1 主舞台（首页首屏）：地图卡 + 状态总览（HUD + 最新事件 1 行）+ NEEDS_KEY/合规占位
    L2 全局传输条（常驻 64dp）：Start / Pause / Stop（三键，不在任何滚动区内）
    L3 一级页（ID 不得改名）：跑道 | 更多 | 控制台
    L4 二级由 L3 页内段落承担（无 Dialog/PopupMenu/BottomSheet/ViewPager2）。

  默认页 = 编辑（matrix_panel_track）：预设/变换/参数/导出全部默认展开、无折叠键。
  日志页可访问但默认不可见（GONE），内含 matrix_console_scroll（SmokeTest 展示行滚动祖先）。

  硬约束：只用 LinearLayout / FrameLayout / ScrollView；零新增依赖；
  装饰性 View 一律 clickable=false + focusable=false + importantForAccessibility=no；
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tl_canvas"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- ═══════════ L0 系统带（48dp 常驻） ═══════════ -->
    <LinearLayout
        android:id="@+id/matrix_top_bar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@color/tl_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="@string/tl_app_title"
            android:textColor="@color/tl_ink_strong"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- 运行状态 LED（16×16dp；颜色由 LedDotView 自持；纯装饰，不吞事件） -->
        <io.github.haohaoo3o.tracklab.ui.matrix.LedDotView
            android:id="@+id/matrix_led_status"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="8dp"
            android:clickable="false"
            android:focusable="false"
            android:importantForAccessibility="no" />

        <!-- 回放状态词（5 值；全局恒写，切页签不停更） -->
        <TextView
            android:id="@+id/matrix_state_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/tl_ink_sub"
            android:textSize="11sp"
            android:typeface="monospace" />

        <!-- 界面时钟（本机挂钟；不是事件发生时刻） -->
        <TextView
            android:id="@+id/matrix_clock"
            style="@style/Widget.TrackLab.TlText.MonoClock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:contentDescription="@string/matrix_clock_cd"
            android:ellipsize="end"
            android:maxLines="1" />

        <!-- 常驻测试徽标：文案与通知同源、恒含「测试」字样；weight=1 + maxLines=2 不挤掉右侧 -->
        <TextView
            android:id="@+id/test_mode_badge"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/tl_badge"
            android:gravity="center_vertical|start"
            android:maxLines="2"
            android:minHeight="24dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="@string/test_mode_badge"
            android:textColor="@color/tl_accent_ink"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@drawable/tl_divider"
        android:clickable="false"
        android:focusable="false"
        android:importantForAccessibility="no" />

    <!-- ═══════════ NEEDS_KEY 诊断条（诊断必须完整：无 maxLines / 无 ellipsize） ═══════════ -->
    <TextView
        android:id="@+id/txt_key_missing"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/tl_card"
        android:padding="8dp"
        android:text="@string/error_amap_key_missing"
        android:textColor="@color/tl_ink_strong"
        android:textSize="11sp" />

    <!-- ═══════════ 测试轨迹声明（常驻合规文案） + 隐私区块 ═══════════ -->
    <TextView
        android:id="@+id/txt_disclaimer"
        style="@style/Widget.TrackLab.TlText.Disclaimer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingTop="4dp"
        android:paddingEnd="12dp"
        android:paddingBottom="4dp"
        android:text="@string/test_disclaimer" />

    <LinearLayout
        android:id="@+id/privacy_dialog_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/tl_card"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/privacy_dialog_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/privacy_dialog_title"
            android:textColor="@color/tl_ink_strong"
            android:textSize="15sp"
            android:textStyle="bold"
            android:letterSpacing="0.10" />

        <TextView
            android:id="@+id/privacy_dialog_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingMultiplier="1.35"
            android:text="@string/privacy_dialog_message"
            android:textColor="@color/tl_ink_sub"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_privacy_deny"
                style="@style/Widget.TrackLab.TlButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:maxLines="2"
                android:text="@string/privacy_dialog_deny" />

            <Button
                android:id="@+id/btn_privacy_agree"
                style="@style/Widget.TrackLab.TlButton.Primary"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:maxLines="2"
                android:text="@string/privacy_dialog_agree" />
        </LinearLayout>
    </LinearLayout>

    <!-- ═══════════ L3 一级页签条（4 枚；ID 被采集脚本导航依赖，不得改名） ═══════════ -->
    <LinearLayout
        android:id="@+id/matrix_tab_bar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:background="@color/tl_surface"
        android:orientation="horizontal">

        <Button
            android:id="@+id/matrix_tab_track"
            style="@style/Widget.TrackLab.TlButton.Tab"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/matrix_tab_track" />

        

        <Button
            android:id="@+id/matrix_tab_more"
            style="@style/Widget.TrackLab.TlButton.Tab"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/matrix_tab_more" />

        <Button
            android:id="@+id/matrix_tab_console"
            style="@style/Widget.TrackLab.TlButton.Tab"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/matrix_tab_console" />
    </LinearLayout>

    <!-- ═══════════ L1 地图卡（圆角不裁切：MapView 系 GL/Surface，clipToOutline 无效） ═══════════ -->
    <FrameLayout
        android:id="@+id/matrix_map_frame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="12dp"
        android:layout_weight="0.42"
        android:background="@drawable/tl_card"
        android:minHeight="140dp">

        <!-- map 阶段挂载 MapView 的容器 -->
        <FrameLayout
            android:id="@+id/map_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/matrix_map_cd" />
    </FrameLayout>

    <!-- ═══════════ L1 状态总览（HUD 四格 + 最新事件 1 行，常驻可见） ═══════════ -->
    <LinearLayout
        android:id="@+id/matrix_hud_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/tl_card"
        android:gravity="center_vertical"
        android:minHeight="44dp"
        android:orientation="vertical"
        android:padding="8dp">

        <TextView
            android:id="@+id/txt_playback_metrics"
            style="@style/Widget.TrackLab.TlText.MonoMetrics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true" />

        <TextView
            android:id="@+id/txt_map_status"
            style="@style/Widget.TrackLab.TlText.MonoEvent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="2" />
    </LinearLayout>

    <!-- ═══════════ L3 页内容宿主（weight=0.58；4 页靠 VISIBLE/GONE 切换） ═══════════ -->
    <FrameLayout
        android:id="@+id/matrix_panel_host"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.58">

        <!-- ─────────── P2 编辑页（默认打开；根 = ScrollView）───────────
             预设 / 变换 / 参数 / 导出全部默认展开、无折叠键（五档与参数禁收起铁律同源）。 -->
        <ScrollView
            android:id="@+id/matrix_panel_track"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="8dp">

                <TextView
                    android:id="@+id/matrix_panel_track_label"
                    style="@style/Widget.TrackLab.TlText.PanelLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="8dp"
                    android:text="@string/tl_sec_edit" />

                <!-- 预制跑道 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/tl_card"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <TextView
                        style="@style/Widget.TrackLab.TlText.Label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/matrix_group_preset" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        

                        <Button
                            android:id="@+id/btn_preset_standard_400"
                            style="@style/Widget.TrackLab.TlButton.Chip"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:text="@string/preset_standard_400" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 整体变换（默认展开：低频也不收起，避免脚本/操作丢失） -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/tl_card"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <TextView
                        style="@style/Widget.TrackLab.TlText.Label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/matrix_group_transform" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="44dp"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="2"
                            style="@style/Widget.TrackLab.TlText.Label"
                            android:text="@string/track_move" />

                        <Button
                            android:id="@+id/btn_track_left"
                            style="@style/Widget.TrackLab.TlButton.Chip"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:contentDescription="@string/cd_track_left"
                            android:text="←" />

                        <Button
                            android:id="@+id/btn_track_up"
                            style="@style/Widget.TrackLab.TlButton.Chip"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:contentDescription="@string/cd_track_up"
                            android:text="↑" />

                        <Button
                            android:id="@+id/btn_track_down"
                            style="@style/Widget.TrackLab.TlButton.Chip"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:contentDescription="@string/cd_track_down"
                            android:text="↓" />

                        <Button
                            android:id="@+id/btn_track_right"
                            style="@style/Widget.TrackLab.TlButton.Chip"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:contentDescription="@string/cd_track_right"
                            android:text="→" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/Widget.TrackLab.TlText.Label"
                            android:layout_width="44dp"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:text="@string/track_scale" />

                        <Button
                            android:id="@+id/btn_track_scale_down"
                            style="@style/Widget.TrackLab.TlButton.Chip"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:contentDescription="@string/cd_track_scale_down"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:text="@string/track_scale_down" />

                        <Button
                            android:id="@+id/btn_track_scale_up"
                            style="@style/Widget.TrackLab.TlButton.Chip"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:contentDescription="@string/cd_track_scale_up"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:text="@string/track_scale_up" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/Widget.TrackLab.TlText.Label"
                            android:layout_width="44dp"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:text="@string/track_rotate" />

                        <Button
                            android:id="@+id/btn_track_rotate_ccw"
                            style="@style/Widget.TrackLab.TlButton.Chip"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:contentDescription="@string/cd_track_rotate_ccw"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:text="@string/track_rotate_ccw" />

                        <Button
                            android:id="@+id/btn_track_rotate_cw"
                            style="@style/Widget.TrackLab.TlButton.Chip"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:contentDescription="@string/cd_track_rotate_cw"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:text="@string/track_rotate_cw" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 参数与导出（默认展开） -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/tl_card"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <TextView
                        style="@style/Widget.TrackLab.TlText.Label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/matrix_group_params" />

                    <!-- 校验：p_base 180–660 整数 / seed long 文本 / 圈数 1–100 整数 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/edit_p_base"
                            style="@style/Widget.TrackLab.TlEdit"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="@string/label_p_base"
                            android:importantForAutofill="no"
                            android:inputType="number"
                            android:maxLength="4"
                            android:singleLine="true" />

                        <EditText
                            android:id="@+id/edit_seed"
                            style="@style/Widget.TrackLab.TlEdit"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:hint="@string/label_seed"
                            android:importantForAutofill="no"
                            android:inputType="numberSigned"
                            android:maxLength="20"
                            android:singleLine="true" />

                        <EditText
                            android:id="@+id/edit_laps"
                            style="@style/Widget.TrackLab.TlEdit"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:hint="@string/label_laps"
                            android:importantForAutofill="no"
                            android:inputType="number"
                            android:maxLength="3"
                            android:singleLine="true" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/txt_range_info"
                        style="@style/Widget.TrackLab.TlText.MonoGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btn_undo"
                            style="@style/Widget.TrackLab.TlButton.Chip"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:text="@string/action_undo" />

                        <Button
                            android:id="@+id/btn_reset"
                            style="@style/Widget.TrackLab.TlButton.Chip"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:text="@string/action_reset" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btn_export_gpx"
                            style="@style/Widget.TrackLab.TlButton.Chip"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:text="@string/action_export_gpx" />

                        <Button
                            android:id="@+id/btn_export_geojson"
                            style="@style/Widget.TrackLab.TlButton.Chip"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:text="@string/action_export_geojson" />
                    </LinearLayout>

                    <!-- 观测噪声只读注记（追加式只读 TextView；默认即观测，无开关） -->
                    
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- ─────────── P3 实验页（根 = ScrollView：SmokeTest 对 lab 控制键用 scrollTo） ───────────
             五档 + 清零在首屏直露、无折叠；探针与板导出在诊断页监控板段（双向可恢复）。 -->
        

        <!-- ─────────── P4 诊断页（根 = ScrollView）：监控板（探针+导出）+ 连接场景 ───────────
             日志全文在「日志」页；本页只留监控操作与连接场景。 -->
        <ScrollView
            android:id="@+id/matrix_panel_more"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="8dp">

                <TextView
                    android:id="@+id/matrix_panel_more_label"
                    style="@style/Widget.TrackLab.TlText.PanelLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="8dp"
                    android:text="@string/tl_sec_diag" />

                                <!-- 连接场景（：仅供本应用 UI/业务测试，不改写系统状态、不影响其他应用） -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/tl_card"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <TextView
                        style="@style/Widget.TrackLab.TlText.Label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/connectivity_label" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btn_conn_default"
                            style="@style/Widget.TrackLab.TlButton.Chip"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:text="@string/connectivity_default" />

                        <Button
                            android:id="@+id/btn_conn_cellular"
                            style="@style/Widget.TrackLab.TlButton.Chip"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:text="@string/connectivity_cellular" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btn_conn_wifi"
                            style="@style/Widget.TrackLab.TlButton.Chip"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:text="@string/connectivity_wifi" />

                        <Button
                            android:id="@+id/btn_conn_offline"
                            style="@style/Widget.TrackLab.TlButton.Chip"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:text="@string/connectivity_offline" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- ─────────── P1 日志页（根 = ScrollView；默认不可见，点「日志」页签进入） ───────────
             matrix_console_scroll；行内等宽排版与诚实口径不变。 -->
        <LinearLayout
            android:id="@+id/matrix_panel_console"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <ScrollView
                android:id="@+id/matrix_console_scroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="false"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/matrix_console_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="20dp">

                    <!-- 段头：会话 · 心跳 · 目标 -->
                    <!-- 段头 + 回执行（Idle 时隐藏；边沿触发，只保留最新一条） -->
                    <!-- 观测区（默认展开，无折叠键） -->
                    <!-- Hook 组观测记录：每条记录显式占两行（计数行 + 状态子行）⇒
                         maxLines = 12 条 × 2 行 = 24；记录数上限仍是 12（超限由截断提示显式提示）。 -->
                    

                    

                    <!-- 行数超限提示（默认 GONE；绝不静默吞行：真实组数 > 上限时置 VISIBLE） -->
                    
                </LinearLayout>
            </ScrollView>
        </LinearLayout>
    </FrameLayout>

    <!-- ═══════════ L2 全局传输条（64dp 常驻；不在任何面板/滚动区内 ⇒ 4 页恒可见） ═══════════
         56dp 实高 = 1dp 发丝 + 4dp 上边距 + 48dp 键 + 下边距；B8 ④ 主控三键恒 enabled。 -->
    <FrameLayout
        android:id="@+id/matrix_control_bar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/tl_surface">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="4dp"
            android:paddingEnd="12dp"
            android:paddingBottom="4dp">

            <Button
                android:id="@+id/btn_start"
                style="@style/Widget.TrackLab.TlButton.Transport.Primary"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:contentDescription="@string/tl_cd_start"
                android:drawableTop="@drawable/ic_ui_play"
                android:text="@string/action_start" />

            <Button
                android:id="@+id/btn_pause"
                style="@style/Widget.TrackLab.TlButton.Transport"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:contentDescription="@string/tl_cd_pause"
                android:drawableTop="@drawable/ic_ui_pause"
                android:text="@string/action_pause" />

            <Button
                android:id="@+id/btn_stop"
                style="@style/Widget.TrackLab.TlButton.Transport"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:contentDescription="@string/tl_cd_stop"
                android:drawableTop="@drawable/ic_ui_stop"
                android:text="@string/action_stop" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_gravity="top"
            android:background="@drawable/tl_divider"
            android:clickable="false"
            android:focusable="false"
            android:importantForAccessibility="no" />
    </FrameLayout>

</LinearLayout>
