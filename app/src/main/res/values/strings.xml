    <string name="overlay_metrics_format">第 %1$d/%2$d 圈 · %3$s km · %4$s /km · %5$s spm（测试/模拟定位）</string>
    <string name="playback_restored_paused">已安全恢复上次测试回放进度（已暂停，不自动续跑）（测试/模拟定位）</string>
    <string name="playback_completed_notice">测试回放完成（测试/模拟定位）</string>

    <!-- 连接场景选择（仅供本应用 UI/业务测试；不改写系统状态、不影响其他应用） -->
    <string name="connectivity_label">连接场景（仅本应用 UI/业务测试，不影响系统与其他应用）</string>
    <string name="connectivity_default">默认</string>
    <string name="connectivity_cellular">蜂窝</string>
    <string name="connectivity_wifi">Wi-Fi</string>
    <string name="connectivity_offline">离线</string>

