<?xml version="1.0" encoding="utf-8"?>
<!-- 键集必须与 values-en/strings.xml 相等（StringsSyncTest 常驻断言、
     lint.xml 忽略 MissingTranslation/ExtraTranslation——双保险）。
     合规常驻文案（test_mode_badge / notification_title / notification_text）在任何语言下保留“测试”字样
（断言 locale 无关）。-->
<resources>
    <string name="app_name">TrackLab</string>

    <!-- 合规常驻文案（保留“测试”字样，全部 locale） -->
    <string name="test_mode_badge">测试/模拟定位中</string>
    <string name="notification_title">测试/模拟定位中</string>
    <string name="notification_text">轨迹回放进行中（测试/模拟定位）</string>
    <string name="notification_channel_name">TrackLab 回放服务</string>

    <!-- NEEDS_KEY 配置提示（Key 缺失时允许编译并在应用内显示） -->
    <string name="error_amap_key_missing">未配置高德地图 API Key（AMAP_API_KEY），在线底图不可用。请在 local.properties 中设置后重新构建。</string>

    <!-- 测试轨迹声明（常驻；不自动控制其他应用） -->
    <string name="test_disclaimer">测试轨迹：仅供本应用地图/轨迹算法与模拟定位测试（测试轨迹），不会自动控制其他应用。</string>

    <!-- 隐私合规对话框（§5） -->
    <string name="privacy_dialog_title">隐私政策</string>
    <string name="privacy_dialog_message">在使用高德地图服务前，请先阅读并同意隐私政策。同意后应用将按合规时序初始化地图 SDK。本应用为测试/模拟定位工具，不隐藏、不 Hook 任何其他应用。</string>
    <string name="privacy_dialog_agree">同意并继续</string>
    <string name="privacy_dialog_deny">不同意</string>
    <string name="privacy_dialog_view_policy">查看隐私政策</string>

    <!-- 主控三键 -->
    <string name="action_start">开始</string>
    <string name="action_pause">暂停</string>
    <string name="action_resume">继续</string>
    <string name="action_stop">停止</string>

    <!-- 悬浮窗控件无障碍描述 -->
    <string name="cd_overlay_pause">暂停回放</string>
    <string name="cd_overlay_resume">继续回放</string>
    <string name="cd_overlay_stop">停止回放</string>

