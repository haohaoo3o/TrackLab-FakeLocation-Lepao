    <string name="point_name_p4">右下切点</string>
    <string name="point_name_p5">右上切点</string>
    <string name="point_title_format">p%1$d %2$s</string>

    <!-- 地图状态行 -->
    <string name="map_hint_next_point">点击/长按地图采集第 %1$d/6 点：%2$s</string>
    <string name="map_hint_all_collected">6 个点位已采集，显示拟合预览与边界走廊</string>
    <string name="map_hint_point_limit">已采集 6 点；继续请先「撤销」或「重置」</string>
    <string name="map_hint_preview_failed">拟合失败：%1$s</string>
    <string name="map_hint_playback_requested">测试轨迹已生成，已进入测试回放入口（测试/模拟定位中）</string>

