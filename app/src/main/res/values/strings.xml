    <string name="error_invalid_p_base">基准配速 p_base 需为 180~660 的整数（秒/公里）</string>
    <string name="error_invalid_laps">圈数需为 1~100 的整数</string>
    <string name="error_invalid_seed">seed 需为十进制整数（long）</string>

    <!-- 六点固定命名（p0 顶部、p1 左上切点、p2 左下切点、p3 底部、p4 右下切点、p5 右上切点） -->
    <string name="point_name_p0">顶部</string>
