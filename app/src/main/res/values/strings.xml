    <string name="range_info">配速 %1$d–%2$d s/km（3:00–11:00 min/km）｜步频 %3$d–%4$d spm（模型固定范围）</string>
    <string name="label_p_base">p_base（s/km）</string>
    <string name="label_seed">seed</string>
    <string name="label_laps">圈数（1–100）</string>

    <!-- 撤销/重置/导出 -->
    <string name="action_undo">撤销</string>
    <string name="action_reset">重置</string>
    <string name="action_export_gpx">导出 GPX</string>
    <string name="action_export_geojson">导出 GeoJSON</string>
    <string name="export_success">已导出：%1$s</string>
    <string name="export_success_toast">测试轨迹已导出（测试/模拟数据）</string>
    <string name="error_export_failed">导出失败：%1$s</string>
    <string name="error_no_track">请先按固定顺序采集 6 个点位并完成拟合</string>
    <string name="error_state_restore">状态恢复失败，已用默认值继续：%1$s</string>
</resources>
