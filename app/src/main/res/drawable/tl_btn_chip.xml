<?xml version="1.0" encoding="utf-8"?>
<!-- TL 次键：浅底 tl_chip_bg + 1dp tl_line 描边；按压 tl_press；选中态跟随 selector（activated）。 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/tl_surface_2" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/tl_press" />
            <corners android:radius="8dp" />
            <stroke android:width="1dp" android:color="@color/tl_line" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/tl_accent_soft" />
            <corners android:radius="8dp" />
            <stroke android:width="1dp" android:color="@color/tl_accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/tl_chip_bg" />
            <corners android:radius="8dp" />
            <stroke android:width="1dp" android:color="@color/tl_line" />
        </shape>
    </item>
</selector>
