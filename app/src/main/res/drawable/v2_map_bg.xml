<?xml version="1.0" encoding="utf-8"?>
<!-- v2 地图卡底：**直角**（radius=0）+ 1dp 结构发丝。
     不做圆角裁切：AMap MapView 内部是 GL/Surface 渲染层，clipToOutline 对 SurfaceView 类不生效；
     卡面层级改由"四角角标（v2_corner）+ 扫描线（v2_scanline）"表达。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/matrix_bg_deep" />
    <stroke android:width="1dp" android:color="@color/v2_hairline" />
</shape>