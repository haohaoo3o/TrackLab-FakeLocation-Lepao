<?xml version="1.0" encoding="utf-8"?>
<!-- TL 输入框：白底 + 1dp 描边；聚焦 tl_accent 描边。禁用 tl_surface_2。 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/tl_field_bg" />
            <corners android:radius="8dp" />
            <stroke android:width="2dp" android:color="@color/tl_accent" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/tl_surface_2" />
            <corners android:radius="8dp" />
            <stroke android:width="1dp" android:color="@color/tl_line" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/tl_field_bg" />
            <corners android:radius="8dp" />
            <stroke android:width="1dp" android:color="@color/tl_line" />
        </shape>
    </item>
</selector>
