<?xml version="1.0" encoding="utf-8"?>
<!-- TrackLab v2 launcher 单色层（Android 13 themed icon，**新增**）—
     与前景同构的新构图（跑道环 / 走廊内圈 / 回放三角 / 起点节点 / 终端游标），108 viewport，
     **全部 #FFFFFFFF**（系统只取 alpha 当单色掩码，不看色相），按掩码观感加粗描边：
       环 6.0（细线在掩码下会糊）、走廊 2.6 alpha 0.85、三角与节点实心 alpha 1.0。
     2026-10-10 复审修复同步：前景的走廊内圈 alpha 0.45→0.85、描边 1.8→2.2（深色底 2.50:1→5.49:1，
     48dp 下不再是暗边）。掩码层同样按「掩码里细线会变淡」的既有口径跟着提：
     走廊 alpha 0.55→**0.85**、描边 2.2→**2.6**（保持掩码约 1.2x 的加粗倍率），
     两道线的相对强弱与前景一致（都在 alpha 0.85 vs 1.0、宽度 2.6 vs 6.0）。
     掩码层的对比度取决于平台给的 tint 与主题底色（浅色/深色主题不同），故不在此声明 WCAG 值。
     终端游标与前景同几何同 alpha（实心元素在两层的掩码观感一致，无需加粗），
     保证「同构」这一条在前景层与单色层之间继续成立。
     安全区实测（脚本逐点采样 pathData，含描边半宽的最远点）：最远点是外环右端半圆顶点
       (81,54)——离中心 27.00 + 描边半宽 3.00 = **r 30.00dp** ≤ 33dp（余量 3.00dp）；
       走廊内圈 r 21.70（左端半圆顶点 (33.6,54)：20.40 + 描边半宽 1.30；描边 2.2→2.6 使该值
       从 21.50 变为 21.70）、起点节点 r 23.60、终端游标 r 14.42，均更小。
     装饰性细线在掩码里会变淡，故走廊 alpha 取前景同值 0.85（原口径是"前景 +0.10"：0.45→0.55），
     保证"两道线"仍可辨。
     由 res/mipmap-anydpi-v26/ic_launcher.xml 的 <monochrome> 引用。
     矢量源：设计资产 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 走廊内圈（几何同前景，描边 1.8 → 2.6，alpha 0.45 → 0.85：2026-10-10 复审修复，
         前景同位置 0.45→0.85 / 1.8→2.2，掩码层按既有 1.2x 加粗倍率取 2.6） -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeAlpha="0.85"
        android:strokeWidth="2.6"
        android:strokeLineCap="round"
        android:pathData="M46,41.6 H62 A12.4,12.4 0 0 1 62,66.4 H46 A12.4,12.4 0 0 1 46,41.6 Z" />

    <!-- 跑道环（几何同前景，描边 4.6 → 6.0，实心 alpha 1.0） -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:pathData="M46,35 H62 A19,19 0 0 1 62,73 H46 A19,19 0 0 1 46,35 Z" />

    <!-- 回放三角（同前景几何，实心白） -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M48.3,45 L64.8,54 L48.3,63 Z" />

    <!-- 起点节点（同前景几何，实心白） -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M54,35 m-4.6,0 a4.6,4.6 0 1,0 9.2,0 a4.6,4.6 0 1,0 -9.2,0 Z" />

    <!-- 终端游标（同前景几何，实心白；掩码下与前景观感一致） -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M39.9,51 H42.9 V57 H39.9 Z" />
</vector>