<?xml version="1.0" encoding="utf-8"?>
<!-- v2 LED 状态点·停止（STOPPED / IDLE）：次级文本色点，无光环。
     停止态是"最安静"的一态：低对比但不消失，也不使用红色（红留给 BLOCKED 语义）。
     宿主 16×16dp；装饰性 clickable=false / focusable=false。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:gravity="center">
        <shape android:shape="oval">
            <size android:width="8dp" android:height="8dp" />
            <solid android:color="@color/matrix_text_secondary" />
        </shape>
    </item>
</layer-list>