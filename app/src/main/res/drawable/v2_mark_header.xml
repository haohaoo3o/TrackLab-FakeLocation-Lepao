<?xml version="1.0" encoding="utf-8"?>
<!-- TrackLab v2 顶栏标识（小徽标 / 字标图形部分）。24dp intrinsic，viewport 24，**单色**。
     构图 = launcher 前景的**简化同构版**：跑道环（胶囊）+ 回放三角；
     去掉走廊内圈（24dp 下 0.5dp 细线不可见）与起点节点（会与环线糊在一起）。
     单色 #E3E9E6（matrix_text_primary）：不着色时与顶栏正文同色；需要强调时由布局上
     android:tint="@color/matrix_success"，因全程只有一种颜色，SRC_IN 染色无副作用。
     安全区：最远点（含描边半宽）r = 9.95 单位 ≤ 11.5（24 viewport 留 2 单位边距）。
     用法（供主界面工程师）：ImageView 24x24dp 或 TextView 的 drawableStart；
     **不要**给它新增 ViewID。
     矢量源：设计资产（同一份 path 数据）。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- 跑道环：直道 x∈[8.8,15.2] 于 y=5.8/18.2，两端半圆 r=6.2 -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#E3E9E6"
        android:strokeWidth="2.4"
        android:strokeLineCap="round"
        android:pathData="M8.8,5.8 H15.2 A6.2,6.2 0 0 1 15.2,18.2 H8.8 A6.2,6.2 0 0 1 8.8,5.8 Z" />

    <!-- 回放三角：6.3 x 7.2，形心 x=12.0（居中） -->
    <path
        android:fillColor="#E3E9E6"
        android:pathData="M9.9,8.4 L16.2,12 L9.9,15.6 Z" />
</vector>