<?xml version="1.0" encoding="utf-8"?>
<!-- v2 徽标底（12% 赭红 + 1dp matrix_error 描边 + 4dp 圆角）。
     三处共用：test_mode_badge（合规常驻）、txt_key_missing 诊断条、悬浮窗合规标记格。
     配对文字色：@color/matrix_error（styles.xml 的 Widget.TrackLab.Text.Badge）。
     实算对比度：on matrix_bg_app（#0E1211）合成底 ≈ #222120 → matrix_error 文字 5.40:1 ✔（≥4.5:1）。
     需要更"醒目"的合规存在感时改用 v2_badge_strong（实底）——那时文字色**必须**换成
     @color/v2_on_accent_text，实底那一组的实测值是 6.56:1。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/v2_badge_fill" />
    <corners android:radius="4dp" />
    <stroke android:width="1dp" android:color="@color/matrix_error" />
</shape>