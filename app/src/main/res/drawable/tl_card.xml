<?xml version="1.0" encoding="utf-8"?>
<!-- TL 卡片：tl_surface 实底 + 8dp 圆角 + 1dp tl_line 描边。原创 shape，无阴影。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/tl_surface" />
    <corners android:radius="8dp" />
    <stroke android:width="1dp" android:color="@color/tl_line" />
</shape>
