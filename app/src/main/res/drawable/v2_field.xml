<?xml version="1.0" encoding="utf-8"?>
<!-- v2 输入框（k=值 / 参数输入）：8dp 圆角 + 1dp 描边（未聚焦 = 结构发丝，
     聚焦 = matrix_success 青描边）。本条采用"边框"形态（非下划线），与 EditText 的
     单行 44dp 命中区一致；hint 色见 styles.xml 的 Widget.TrackLab.Edit（v2_text_tertiary）。 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/v2_surface_2" />
            <corners android:radius="8dp" />
            <stroke android:width="1dp" android:color="@color/matrix_success" />
        </shape>
    </item>

    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/v2_surface_1" />
            <corners android:radius="8dp" />
            <stroke android:width="1dp" android:color="@color/matrix_divider" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/v2_surface_2" />
            <corners android:radius="8dp" />
            <stroke android:width="1dp" android:color="@color/v2_hairline" />
        </shape>
    </item>
</selector>