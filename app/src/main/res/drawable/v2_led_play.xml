<?xml version="1.0" encoding="utf-8"?>
<!-- v2 LED 状态点·运行（PLAYING）：青环（35% matrix_success）+ 青实心点。颜色已烘焙，
     不需要运行时 tint —— 布局直接换件即可表达三态（play/pause/stop）。
     宿主 16×16dp；装饰性 clickable=false / focusable=false / importantForAccessibility="no"。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:gravity="center">
        <shape android:shape="oval">
            <size android:width="16dp" android:height="16dp" />
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="#5986AE9A" />
        </shape>
    </item>
    <item android:gravity="center">
        <shape android:shape="oval">
            <size android:width="8dp" android:height="8dp" />
            <solid android:color="@color/matrix_success" />
        </shape>
    </item>
</layer-list>