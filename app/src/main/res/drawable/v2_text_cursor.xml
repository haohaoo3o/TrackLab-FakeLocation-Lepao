<?xml version="1.0" encoding="utf-8"?>
<!-- v2 输入光标：2dp 宽 matrix_success 实条（深色底上必须给光标上色，否则默认光标在
     部分 ROM 上是白/黑且与暗底撞色）。被 Widget.TrackLab.Edit 的 android:textCursorDrawable
     引用（该属性 API 29+；API 26–28 由 colorControlActivated = matrix_success 着色，同为青）。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/matrix_success" />
    <size android:width="2dp" />
</shape>