<?xml version="1.0" encoding="utf-8"?>
<!-- v2 竖分隔线（1dp matrix_divider）：用于横向 LinearLayout 内的等分元素之间
     （如主控三键之间、页签之间）。宿主 View 宽 1dp + 高度 match_parent。
     装饰性 clickable=false / focusable=false。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/matrix_divider" />
    <size android:width="1dp" />
</shape>